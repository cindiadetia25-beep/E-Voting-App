<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Real Count Pemilu - E-Voting Digital</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { 
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364); 
            min-height: 100vh; 
            color: #fff; 
            padding: 30px 20px; 
        }
        .container { max-width: 950px; margin: 0 auto; }
        
        header { text-align: center; margin-bottom: 35px; }
        header h1 { font-size: 2.3rem; font-weight: 800; color: #00f2fe; margin-bottom: 8px; text-shadow: 0 4px 15px rgba(0,242,254,0.3); }
        header p { color: #a1c4fd; font-size: 1rem; }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        .stat-card i { font-size: 2rem; color: #00f2fe; margin-bottom: 10px; }
        .stat-card h2 { font-size: 2.2rem; font-weight: 800; color: #fff; margin-bottom: 4px; }
        .stat-card p { font-size: 0.85rem; color: #a1c4fd; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }

        .main-card {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 20px;
            padding: 30px 25px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.37);
            margin-bottom: 30px;
        }
        .section-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #00f2fe;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 12px;
        }

        .results-container { display: flex; flex-direction: column; gap: 20px; }
        .candidate-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: transform 0.3s ease, border-color 0.3s ease;
        }
        .candidate-card:hover {
            transform: translateY(-3px);
            border-color: rgba(0, 242, 254, 0.4);
        }
        .candidate-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #00f2fe;
            box-shadow: 0 0 12px rgba(0,242,254,0.3);
            flex-shrink: 0;
            background: rgba(255,255,255,0.1);
        }
        .candidate-info { flex: 1; }
        .candidate-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 10px;
        }
        .candidate-name { font-size: 1.2rem; font-weight: 700; color: #fff; }
        .candidate-votes { font-size: 0.95rem; color: #a1c4fd; margin-top: 2px; }
        .candidate-percentage { font-size: 1.6rem; font-weight: 800; color: #00f2fe; text-shadow: 0 0 10px rgba(0,242,254,0.3); }

        .progress-bar-bg {
            width: 100%;
            height: 14px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }
        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #00c6ff, #0072ff);
            border-radius: 10px;
            transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 8px rgba(0, 198, 255, 0.6);
        }

        .chart-box { max-width: 320px; margin: 0 auto; }
        
        #statusFooter {
            text-align: center;
            color: #a1c4fd;
            font-size: 0.85rem;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1><i class="fas fa-chart-line"></i> Real Count Pemilihan</h1>
        <p>Hasil Perhitungan Suara Digital Secara Transparan & Real-Time</p>
    </header>

    <div class="summary-grid">
        <div class="stat-card">
            <i class="fas fa-vote-yea"></i>
            <h2 id="totalVotes">0</h2>
            <p>Total Suara Masuk</p>
        </div>
        <div class="stat-card">
            <i class="fas fa-clock"></i>
            <h2 id="lastUpdated">--:--</h2>
            <p>Update Terakhir</p>
        </div>
    </div>

    <div class="main-card">
        <div class="section-title">
            <i class="fas fa-poll-h"></i> Rekapitulasi Suara Pasangan Calon
        </div>
        <div id="resultsList" class="results-container">
            <p style="text-align: center; color: #a1c4fd;"><i class="fas fa-spinner fa-spin"></i> Memuat data perhitungan suara...</p>
        </div>
    </div>

    <div class="main-card">
        <div class="section-title" style="justify-content: center; border-bottom: none; margin-bottom: 10px;">
            <i class="fas fa-chart-pie"></i> Diagram Proporsi Suara
        </div>
        <div class="chart-box">
            <canvas id="voteChart"></canvas>
        </div>
    </div>

    <div id="statusFooter">
        <i class="fas fa-sync fa-spin" id="syncIcon"></i> <span id="statusText">Menyinkronkan dengan server...</span>
    </div>
</div>

<script>
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxaZY2O1fOGiegdwFaPW8cUHPDuq4LGSeGbc7y9MeIWQho3bzHf2qCty3Z1gDhGuW7s/exec";

    let myChart = null;

    async function fetchRealCount() {
        try {
            const res = await fetch(SCRIPT_URL);
            const data = await res.json();

            const candidates = data.candidates || [];
            const votesData = data.votes || {};

            let totalVotes = 0;
            Object.values(votesData).forEach(v => totalVotes += v);

            document.getElementById("totalVotes").innerText = totalVotes.toLocaleString('id-ID');
            document.getElementById("lastUpdated").innerText = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

            renderPemiluResults(candidates, votesData, totalVotes);
            updateChart(candidates, votesData);

            document.getElementById("syncIcon").className = "fas fa-check-circle";
            document.getElementById("syncIcon").style.color = "#38ef7d";
            document.getElementById("statusText").innerText = "Terhubung secara Real-Time ke Server";
        } catch (err) {
            console.error(err);
            document.getElementById("syncIcon").className = "fas fa-exclamation-triangle";
            document.getElementById("syncIcon").style.color = "#f44336";
            document.getElementById("statusText").innerText = "Gagal memperbarui data dari server.";
        }
    }

    function renderPemiluResults(candidates, votesData, totalVotes) {
        const container = document.getElementById("resultsList");
        container.innerHTML = "";

        if (candidates.length === 0) {
            container.innerHTML = "<p style='text-align:center; color:#a1c4fd;'>Belum ada data paslon.</p>";
            return;
        }

        candidates.forEach((c) => {
            const count = votesData[c.name] || 0;
            const percentage = totalVotes > 0 ? ((count / totalVotes) * 100).toFixed(1) : "0.0";

            const card = document.createElement("div");
            card.className = "candidate-card";
            card.innerHTML = `
                <img src="${c.photo || 'https://via.placeholder.com/150'}" class="candidate-avatar" alt="${c.name}" onerror="this.src='https://via.placeholder.com/150'">
                <div class="candidate-info">
                    <div class="candidate-header">
                        <div>
                            <div class="candidate-name">${c.name}</div>
                            <div class="candidate-votes"><i class="fas fa-ticket-alt"></i> ${count.toLocaleString('id-ID')} Suara</div>
                        </div>
                        <div class="candidate-percentage">${percentage}%</div>
                    </div>
                    <div class="progress-bar-bg">
                        <div class="progress-bar-fill" style="width: ${percentage}%;"></div>
                    </div>
                </div>
            `;
            container.appendChild(card);
        });
    }

    function updateChart(candidates, votesData) {
        const labels = candidates.map(c => c.name);
        const votes = candidates.map(c => votesData[c.name] || 0);

        const ctx = document.getElementById('voteChart').getContext('2d');
        if (myChart) myChart.destroy();

        myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: votes,
                    backgroundColor: ['#00f2fe', '#4facfe', '#00c6ff', '#0072ff', '#a1c4fd', '#38ef7d'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#fff', font: { size: 12 } } }
                }
            }
        });
    }

    fetchRealCount();
    setInterval(fetchRealCount, 5000);
</script>

</body>
</html>
